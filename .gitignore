# GMae 项目 .gitignore

# === 日志 ===
*.log
logs/

# === 临时文件 ===
_*
_tmp/
_temp/
*.tmp
*.bak
*.bak*
*.bak_*
*.backup
*.old
*~

# === Python 缓存 ===
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/

# === Node ===
node_modules/

# === 环境变量与密钥 ===
.env
.env.local
*.key
*.pem
.api_token
*.token

# === 编辑器/IDE ===
.vscode/
.idea/
*.swp
*.swo

# === 操作系统 ===
.DS_Store
Thumbs.db
desktop.ini

# === 模型文件（大文件，不入库） ===
models/
model_parts/
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.ckpt
fooocus_expansion.bin

# === 输出产物（图/视频/音频，不入库） ===
outputs/
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.avi
*.mov
*.wav
*.mp3
*.flac

# === 安装包/备份 ===
_installers/
*.zip
*.tar.gz
*.7z
*.rar

# === Docker 数据 ===
docker-data/
volumes/

# === 进程/PID 文件 ===
*.pid

# === 用户数据（密码哈希，不入库） ===
users.json
config.json
